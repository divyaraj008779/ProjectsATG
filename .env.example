# Server Configuration
HOST=127.0.0.1
PORT=8000

# AI Provider Configuration (Optional: Leave blank to use built-in Realistic Mock AI)
# If provided, the backend will call the respective provider securely
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Preferred AI Provider: 'gemini', 'openai', 'groq', or 'mock'
DEFAULT_AI_PROVIDER=auto
